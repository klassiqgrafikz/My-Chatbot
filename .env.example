# Chatbot UI

# Optional: default model shown on first load (valid: gpt-3.5-turbo, gpt-4)
# DEFAULT_MODEL=gpt-3.5-turbo

# Default system prompt used for new conversations
# DEFAULT_SYSTEM_PROMPT=You are ChatGPT, a large language model trained by OpenAI. Follow the user's instructions carefully. Respond using markdown.

# When set, the app uses this server-side key and works out of the box.
# Leave it unset to let each visitor enter their own OpenAI API key in the app
# sidebar (stored in their browser only) and get started instantly.
# OPENAI_API_KEY=sk-...

# Only needed if you access OpenAI through a proxy/custom host
# OPENAI_API_HOST=https://api.openai.com

# Only needed if you belong to multiple OpenAI organizations
# OPENAI_ORGANIZATION=

# Google Search plugin (optional) - enables the "Google Search" plugin
# GOOGLE_API_KEY=YOUR_API_KEY
# GOOGLE_CSE_ID=YOUR_ENGINE_ID
